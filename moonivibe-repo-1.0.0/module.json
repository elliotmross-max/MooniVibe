{
  "id": "moonivibe",
  "name": "MooniVibe",
  "abbrev": "MVB",
  "version": "1.0.0",
  "description": "Stereo phase shifter with swappable circuit parts: four all-pass stages driven by mismatched photocells, plus capacitors, lamps, drive resistors and clipping diodes you can substitute.",
  "author": "Moongriffin",
  "license": "MIT",
  "dsp": "moonivibe.so",
